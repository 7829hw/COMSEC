# Discord 봇 토큰 (Discord Developer Portal에서 발급)
DISCORD_TOKEN=your_discord_bot_token_here

# 암구호를 전송할 채널 ID (채널 우클릭 → ID 복사)
CHANNEL_ID=your_channel_id_here

# 매일 암구호를 전송할 시각 (24시간제, 기본값: 9시)
SEND_HOUR=9

# 생성된 암구호 이력 저장 경로 (선택값, 기본: data/history.json)
# 컨테이너에서는 compose.yaml의 ./data 볼륨에 저장되어 재생성 후에도 유지됨
HISTORY_FILE=data/history.json

# LLM API 키 (사용할 OpenAI 호환 API 제공자에서 발급) — 필수
LLM_API_KEY=your_api_key_here

# LLM API Base URL (OpenAI 호환 엔드포인트, /chat/completions는 코드에서 자동으로 붙임) — 필수
# 예: NVIDIA Build = https://integrate.api.nvidia.com/v1 (https://build.nvidia.com/settings/api-keys)
#     OpenAI       = https://api.openai.com/v1
#     로컬 vLLM     = http://localhost:8000/v1
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# 사용할 모델명 (provider별로 다름) — 필수
LLM_MODEL=google/gemma-4-31b-it

# 요청 payload에 그대로 병합할 추가 필드 (JSON 오브젝트 문자열, 선택값 — 없으면 아무것도 병합 안 함)
# 예: NVIDIA/vLLM 계열의 reasoning(enable_thinking) 확장 필드를 쓰려면:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":true}}
LLM_EXTRA_BODY=
