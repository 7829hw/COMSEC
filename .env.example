# Discord 봇 토큰 (Discord Developer Portal에서 발급)
DISCORD_TOKEN=your_discord_bot_token_here

# 암구호를 전송할 채널 ID (채널 우클릭 → ID 복사)
CHANNEL_ID=your_channel_id_here

# 매일 암구호를 전송할 시각 (24시간제, 기본값: 9시)
SEND_HOUR=9

# NVIDIA Build API 키 (https://build.nvidia.com/settings/api-keys)
NVIDIA_API_KEY=nvapi-your_api_key_here
